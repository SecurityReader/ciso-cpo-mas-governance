# Copy this file to .env and fill in values. Do NOT commit .env to git.
# Shell:  set -a; source .env; set +a
# --- API keys (leave empty; supplied at runtime) ---
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
# --- Generation model (generator must differ from judges) ---
GEN_MODEL=claude-sonnet-5
# --- Judge ensemble: exclude the generator; >=1 non-Anthropic ---
JUDGE_MODELS=claude-haiku-4-5-20251001,gpt-5.1,gpt-4.1-mini
# --- Local embedding for consensus (no API) ---
EMBED_MODEL=BAAI/bge-m3
EMBED_TAU=0.75
# --- Run parameters ---
LLM_BACKEND=api
TEMPERATURE=0.7
REPS=3
MAX_TOKENS=4000
# --- Optional: corporate/self-signed root CA bundle (path), if behind an intercepting proxy ---
# HARNESS_CA_BUNDLE=
